# Copy this file to .env and fill in real values. Never commit .env.

# --- QuickBooks Online ---
# From https://developer.intuit.com  ->  your app  ->  Keys & OAuth
QB_CLIENT_ID=your-quickbooks-client-id
QB_CLIENT_SECRET=your-quickbooks-client-secret

# Must match EXACTLY the Redirect URI registered in the Intuit portal.
# Local dev example:
QB_REDIRECT_URI=http://localhost:5000/callback

# sandbox | production  (must match the Keys & OAuth tab you copied credentials from)
QB_ENVIRONMENT=sandbox

# --- Anthropic (Claude) ---
# From https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key
